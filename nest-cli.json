{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "/assets",
        "outDir": "dist/public",
        "watchAssets": true
      },
      {
        "include": "views",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ],
    "exclude": ["frontend/**/*"],
    "watchOptions": {
      "ignored": ["frontend/**/*", "node_modules/**/*", "dist/**/*"]
    }
  }
} 