<div class="container mt-3">
    <button class="btn btn-primary" type="button" id="invite">
        Mời thành viên
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
    </button>
    
    {{!-- Section ẩn để parse cookie từ curl --}}
    <div id="cookieParserSection" class="card mb-4" style="display: none;">
        <div class="card-body">
            <div class="form-group">
                <label for="curlCommand">Dán cURL command vào đây:</label>
                <textarea class="form-control" id="curlCommand" rows="8" placeholder="Dán cURL command của bạn vào đây..."></textarea>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" id="parseCurlBtn">
                    <i class="fas fa-magic"></i> Parse Cookies
                </button>
                <button type="button" class="btn btn-secondary ml-2" id="clearCurlBtn">
                    <i class="fas fa-trash"></i> Clear
                </button>
            </div>
            <div id="parsedResult" class="mt-3" style="display: none;">
                <div class="input-group">
                    <input type="text" class="form-control" id="cookieString" readonly>
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="copyCookieString">
                            <i class="fas fa-copy"></i> Copy
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h2>Danh Sách Cookies</h2>
    <button id="addCookie" class="btn btn-success">Add Cookie</button>

    <div class="table-responsive-lg">
        <table class="table table-bordered" id="cookieTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Value</th>
                    <th>Status</th>
                    <th>Time Created</th>
                    <th>Time Updated</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
              
            </tbody>
        </table>
    </div>

    {{!-- modal addCookie using boostrap --}}
    <div class="modal fade bd-example-modal-lg " id="cookieModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="addCookieForm">
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" class="form-control" id="email" name="email" aria-describedby="emailHelp">
                        </div>
                        <div class="form-group">
                            <label for="value">Value</label>
                            <textarea class="form-control" id="value" name="value" rows="4"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

{{!-- Thêm script để xử lý cookie parser --}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const parserSection = document.getElementById('cookieParserSection');
    let isParserVisible = false;
    
    // Xử lý phím + để toggle
    document.addEventListener('keydown', function(e) {
        // Kiểm tra nếu phím được nhấn là + hoặc =
        if (e.key === '+' || e.key === '=') {
            e.preventDefault(); // Ngăn chặn hành vi mặc định
            toggleParser();
        }
    });

    function toggleParser() {
        isParserVisible = !isParserVisible;
        parserSection.style.display = isParserVisible ? 'block' : 'none';
        
        // Nếu đang hiện, focus vào textarea
        if (isParserVisible) {
            document.getElementById('curlCommand').focus();
        }
    }

    // Xử lý parse cURL command
    const parseBtn = document.getElementById('parseCurlBtn');
    const clearBtn = document.getElementById('clearCurlBtn');
    const curlInput = document.getElementById('curlCommand');
    const parsedResult = document.getElementById('parsedResult');
    const cookieString = document.getElementById('cookieString');

    parseBtn.addEventListener('click', function() {
        const curlCommand = curlInput.value;
        if (!curlCommand) {
            alert('Vui lòng nhập cURL command!');
            return;
        }

        // Parse cookies từ cURL command
        const cookies = parseCurlCookies(curlCommand);
        if (cookies.length === 0) {
            alert('Không tìm thấy cookies trong cURL command!');
            return;
        }

        // Hiển thị kết quả
        updateCookieString(cookies);
        parsedResult.style.display = 'block';
    });

    clearBtn.addEventListener('click', function() {
        curlInput.value = '';
        parsedResult.style.display = 'none';
        cookieString.value = '';
    });

    function parseCurlCookies(curlCommand) {
        const cookies = [];
        const cookieMatch = curlCommand.match(/-b\s+'([^']+)'/);
        
        if (cookieMatch && cookieMatch[1]) {
            const cookieString = cookieMatch[1];
            const cookiePairs = cookieString.split(';');
            
            cookiePairs.forEach(pair => {
                const [name, value] = pair.trim().split('=');
                if (name && value) {
                    cookies.push({
                        name: name.trim(),
                        value: value.trim()
                    });
                }
            });
        }
        
        return cookies;
    }

    function updateCookieString(cookies) {
        const cookieString = cookies.map(cookie => `${cookie.name}=${cookie.value}`).join('; ');
        document.getElementById('cookieString').value = cookieString;
    }

    // Thêm event listener cho nút copy
    document.getElementById('copyCookieString').addEventListener('click', function() {
        const cookieString = document.getElementById('cookieString');
        cookieString.select();
        document.execCommand('copy');
        
        // Hiển thị thông báo copy thành công
        const originalText = this.innerHTML;
        this.innerHTML = '<i class="fas fa-check"></i> Copied!';
        setTimeout(() => {
            this.innerHTML = originalText;
        }, 2000);
    });
});
</script>
